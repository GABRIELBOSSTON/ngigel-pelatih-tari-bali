# Salin menjadi .env lalu isi nilainya. JANGAN commit berkas .env.
# Variabel berawalan VITE_ terlihat di peramban: hanya untuk nilai PUBLIK.

# Supabase (kunci publik/anon, aman di peramban karena dibatasi aturan akses)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hanya di server (Vercel Functions); jangan diberi awalan VITE_
SUPABASE_SERVICE_ROLE_KEY=

# LLM untuk kalimat koreksi (penyedia dipilih kemudian)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=6000
